/**
 * Cloudflare Workers config for the FTC Team Analysis SPA + live-data proxy.
 * Static assets are served from Vite `dist/`. Only the allowlisted live proxy
 * prefixes invoke the Worker script (keeps normal page views on the free
 * static-asset path).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ftc-team-analysis",
  "compatibility_date": "2026-08-14",
  "main": "worker/proxy.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ftc-proxy",
      "/ftc-proxy/*",
      "/ftcscout-proxy",
      "/ftcscout-proxy/*",
      "/portfolio-lab-proxy",
      "/portfolio-lab-proxy/*",
      "/ftc-scoring-proxy",
      "/ftc-scoring-proxy/*",
      "/open-alliance-proxy",
      "/open-alliance-proxy/*",
      "/ftc-api-proxy",
      "/ftc-api-proxy/*"
    ]
  }
}
