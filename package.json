{
  "name": "ftc-team-analysis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11"
  },
  "scripts": {
    "sync:data": "tsx scripts/sync-public-data.ts",
    "generate:snapshots": "tsx scripts/generate-snapshot-tree.ts",
